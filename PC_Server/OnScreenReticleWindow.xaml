<Window x:Class="CameraGun.Server.OnScreenReticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reticle"
        Width="64" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF66"/>
        <SolidColorBrush x:Key="AccentP2" Color="#FF0055"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFD700"/>
    </Window.Resources>
    <Canvas Width="64" Height="64">
        <!-- Outer Ring -->
        <Ellipse x:Name="outerRing" Width="48" Height="48" Canvas.Left="8" Canvas.Top="8"
                 Stroke="{StaticResource AccentCyan}" StrokeThickness="2"
                 StrokeDashArray="4,3"/>
        
        <!-- Reticle crosshair arms -->
        <Line x:Name="armTop" X1="32" Y1="6" X2="32" Y2="19" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line x:Name="armBottom" X1="32" Y1="45" X2="32" Y2="58" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line x:Name="armLeft" X1="6" Y1="32" X2="19" Y2="32" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line x:Name="armRight" X1="45" Y1="32" X2="58" Y2="32" Stroke="#00E5FF" StrokeThickness="2"/>

        <!-- Center Aiming Dot -->
        <Ellipse x:Name="centerDot" Width="8" Height="8" Canvas.Left="28" Canvas.Top="28"
                 Fill="{StaticResource AccentGreen}" Stroke="#00E5FF" StrokeThickness="1"/>

        <!-- Player Badge (1P / 2P) -->
        <Border x:Name="badgeBorder" Canvas.Left="38" Canvas.Top="4" Background="#CC0A0E1A" CornerRadius="4" Padding="3,1">
            <TextBlock x:Name="txtPlayerTag" Text="1P" FontSize="8" FontWeight="Bold"
                       Foreground="{StaticResource AccentCyan}"/>
        </Border>
    </Canvas>
</Window>
