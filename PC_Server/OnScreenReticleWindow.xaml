<Window x:Class="CameraGun.Server.OnScreenReticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reticle"
        Width="60" Height="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF66"/>
    </Window.Resources>
    <Canvas Width="60" Height="60">
        <!-- Outer Ring -->
        <Ellipse x:Name="outerRing" Width="44" Height="44" Canvas.Left="8" Canvas.Top="8"
                 Stroke="{StaticResource AccentCyan}" StrokeThickness="2"
                 StrokeDashArray="4,3"/>
        
        <!-- Reticle crosshair arms -->
        <Line X1="30" Y1="6" X2="30" Y2="18" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line X1="30" Y1="42" X2="30" Y2="54" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line X1="6" Y1="30" X2="18" Y2="30" Stroke="#00E5FF" StrokeThickness="2"/>
        <Line X1="42" Y1="30" X2="54" Y2="30" Stroke="#00E5FF" StrokeThickness="2"/>

        <!-- Center Aiming Dot -->
        <Ellipse x:Name="centerDot" Width="8" Height="8" Canvas.Left="26" Canvas.Top="26"
                 Fill="{StaticResource AccentGreen}" Stroke="#00E5FF" StrokeThickness="1"/>
    </Canvas>
</Window>
