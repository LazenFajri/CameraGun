<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg_dark"
    android:keepScreenOn="true">

    <!-- Layer 0: Camera Preview (Full screen) -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Corner Detection & Reticle HUD -->
    <com.cameragun.lightgun.CornerOverlayView
        android:id="@+id/cornerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: Top HUD Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cyber_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <!-- BT Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/dotBt"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_indicator" />
            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/bt_disconnected"
                android:textColor="@color/cyber_orange"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/cyber_border" />

        <!-- Tracking Status -->
        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tracking_lost"
            android:textColor="@color/cyber_orange"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/cyber_border" />

        <!-- Coordinates -->
        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="X: 0.000 | Y: 0.000"
            android:textColor="@color/cyber_text_primary"
            android:textSize="9sp" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/cyber_border" />

        <!-- FPS Counter -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0 FPS"
            android:textColor="@color/cyber_green"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- Player Role (1P / 2P) Button -->
        <Button
            android:id="@+id/btnPlayerRole"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🎯 1P"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/cyber_border" />

        <!-- GKHeart RECENTER Button -->
        <Button
            android:id="@+id/btnRecenter"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="8dp"
            android:text="🎯 RECENTER"
            android:textColor="@color/cyber_green"
            android:textSize="8sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/cyber_border" />

        <!-- Wi-Fi Connect Button -->
        <Button
            android:id="@+id/btnWifi"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="📶 WI-FI"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/cyber_border" />

        <!-- Orientation Toggle Button -->
        <Button
            android:id="@+id/btnToggleOrientation"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="📱 PORT"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/cyber_border" />

        <!-- Border Color Quick Toggle -->
        <Button
            android:id="@+id/btnBorderColor"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🎨 CYAN"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Layer 3: LANDSCAPE CONTROLS (Gamepad Style: Left + Right + Center Bottom Reload) -->
    <FrameLayout
        android:id="@+id/landscapeControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Left Controls: L2 Trigger, Share, D-Pad -->
        <RelativeLayout
            android:id="@+id/leftControls"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTriggerL2"
                android:layout_width="90dp"
                android:layout_height="75dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_cyber_trigger"
                android:text="TRIGGER\nL2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:layout_toEndOf="@id/btnTriggerL2"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="SHARE"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="9sp" />

            <RelativeLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">

                <Button
                    android:id="@+id/btnDpadUp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▲"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnDpadLeft"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="◀"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnDpadRight"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▶"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnDpadDown"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▼"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="18sp" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Right Controls: R2 Trigger, Options, Action Buttons (△, □, ○, ✖) -->
        <RelativeLayout
            android:id="@+id/rightControls"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTriggerR2"
                android:layout_width="90dp"
                android:layout_height="75dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_cyber_trigger"
                android:text="ALT FIRE\nR2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <Button
                android:id="@+id/btnOptions"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:layout_toStartOf="@id/btnTriggerR2"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="OPTION"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="9sp" />

            <RelativeLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true">

                <Button
                    android:id="@+id/btnTriangle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="△"
                    android:textColor="@color/ps_triangle"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnSquare"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="□"
                    android:textColor="@color/ps_square"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnCircle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="○"
                    android:textColor="@color/ps_circle"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnCross"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="✖"
                    android:textColor="@color/ps_cross"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Center Bottom Reload Button for Landscape -->
        <Button
            android:id="@+id/btnReload"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_cyber_reload"
            android:text="⟳  RELOAD"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:hapticFeedbackEnabled="true" />
    </FrameLayout>

    <!-- Layer 4: PORTRAIT CONTROLS (Pistol Grip Layout: Bottom Grip + Center Trigger) -->
    <RelativeLayout
        android:id="@+id/portraitControls"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- D-Pad (Left side) -->
        <RelativeLayout
            android:id="@+id/port_dpadArea"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignParentStart="true"
            android:layout_above="@id/port_btnReload"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/port_btnDpadUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▲"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/port_btnDpadLeft"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="◀"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/port_btnDpadRight"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▶"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/port_btnDpadDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▼"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Triggers Area (Center) -->
        <LinearLayout
            android:id="@+id/port_triggerArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/port_dpadArea"
            android:layout_toStartOf="@id/port_actionArea"
            android:layout_above="@id/port_btnReload"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- L2 Primary Trigger (Big ergonomic pistol trigger) -->
            <Button
                android:id="@+id/port_btnTriggerL2"
                android:layout_width="100dp"
                android:layout_height="65dp"
                android:background="@drawable/btn_cyber_trigger"
                android:text="TRIGGER\nL2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <!-- R2 Secondary Fire -->
            <Button
                android:id="@+id/port_btnTriggerR2"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_cyber_trigger"
                android:text="ALT R2"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />
        </LinearLayout>

        <!-- PlayStation Action Buttons (Right side) -->
        <RelativeLayout
            android:id="@+id/port_actionArea"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/port_btnReload"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/port_btnTriangle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_action"
                android:text="△"
                android:textColor="@color/ps_triangle"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/port_btnSquare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_action"
                android:text="□"
                android:textColor="@color/ps_square"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/port_btnCircle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_action"
                android:text="○"
                android:textColor="@color/ps_circle"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/port_btnCross"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_action"
                android:text="✖"
                android:textColor="@color/ps_cross"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Option & Share Buttons (Small) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/port_triggerArea"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/port_btnShare"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="SHARE"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />

            <Button
                android:id="@+id/port_btnOptions"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="OPTION"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Wide Reload Bar at the very bottom -->
        <Button
            android:id="@+id/port_btnReload"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/btn_cyber_reload"
            android:text="⟳  RELOAD"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:hapticFeedbackEnabled="true" />
    </RelativeLayout>

    <!-- Layer 5: Guide / Tutorial Button (Side Control) -->
    <Button
        android:id="@+id/btnHelp"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/btn_cyber_menu"
        android:text="?"
        android:textColor="@color/cyber_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Layer 6: Tutorial & Setup Guide Modal Overlay -->
    <FrameLayout
        android:id="@+id/layoutTutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="16dp"
            android:background="@drawable/bg_cyber_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="📖 PANDUAN PENGGUNAAN"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseTutorial"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_menu"
                    android:text="✕"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="14sp" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cyber_border"
                android:layout_marginBottom="8dp" />

            <!-- Scrollable Guide Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section: Apakah Wajib ViGEmBus? -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❓ APAKAH HARUS PAKAI VIGEMBUS DI PC?"
                        android:textColor="@color/cyber_orange"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="JAWABAN: TIDAK WAJIB!\n• PC Server otomatis menggunakan Absolute Mouse Pointer yang langsung kompatibel dengan Teknoparrot, Dolphin Wii, MAME, Model 2/3, dan game arcade PC tanpa driver tambahan apapun.\n• ViGEmBus hanya diperlukan jika memainkan emulator PS2/PS3 (PCSX2/RPCS3) yang mewajibkan input virtual stick Xbox/DualShock."
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Section: Cara Membidik -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 1. CARA MEMBIDIK (PORTRAIT / LANDSCAPE)"
                        android:textColor="@color/cyber_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Anda bisa bermain dalam posisi TEGAK (Portrait) seperti pistol sungguhan, atau MENDATAR (Landscape).\n• Tekan tombol '📱 PORT / 🖥️ LAND' di bar atas untuk mengganti mode orientasi kapan saja.\n• Arahkan kamera HP ke monitor sampai kotak hijau 'TARGET: LOCKED' aktif mengunci border monitor."
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Section: Tombol Kontrol -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 2. FUNGSI TOMBOL CONTROLLER"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
