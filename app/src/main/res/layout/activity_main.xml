<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Camera Preview Stream -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Corner Detection & Reticle HUD Overlay -->
    <com.cameragun.lightgun.CornerOverlayView
        android:id="@+id/cornerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:background="@drawable/hud_background"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvBtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bt_disconnected"
            android:textColor="#FFAA00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tracking_lost"
            android:textColor="#FF3333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="X: 0.00 | Y: 0.00"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: 0"
            android:textColor="@color/neon_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LEFT CONTROLLER: D-Pad & L2 Main Trigger -->
    <RelativeLayout
        android:id="@+id/leftControls"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp">

        <!-- L2 Trigger (Primary Fire) -->
        <Button
            android:id="@+id/btnTriggerL2"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/btn_trigger"
            android:text="TRIGGER\n(L2)"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_toEndOf="@id/btnTriggerL2"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_dpad"
            android:text="SHARE"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <!-- D-Pad Grid -->
        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true">

            <Button
                android:id="@+id/btnDpadUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_dpad"
                android:text="▲"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnDpadLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_dpad"
                android:text="◀"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnDpadRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_dpad"
                android:text="▶"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnDpadDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_dpad"
                android:text="▼"
                android:textColor="@color/white" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- RIGHT CONTROLLER: PlayStation Action Buttons & R2 -->
    <RelativeLayout
        android:id="@+id/rightControls"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <!-- R2 Secondary Trigger -->
        <Button
            android:id="@+id/btnTriggerR2"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/btn_trigger"
            android:text="ALT FIRE\n(R2)"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOptions"
            android:layout_width="65dp"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/btnTriggerR2"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_dpad"
            android:text="OPTION"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <!-- PS Action Buttons Grid -->
        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">

            <Button
                android:id="@+id/btnTriangle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_round_action"
                android:text="▲"
                android:textColor="@color/ps_triangle"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSquare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_round_action"
                android:text="■"
                android:textColor="@color/ps_square"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCircle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_round_action"
                android:text="●"
                android:textColor="@color/ps_circle"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCross"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_round_action"
                android:text="✖"
                android:textColor="@color/ps_cross"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- CENTER BOTTOM: Offscreen Reload Button / Gesture Zone -->
    <Button
        android:id="@+id/btnReload"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_reload"
        android:text="@string/reload_label"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>
