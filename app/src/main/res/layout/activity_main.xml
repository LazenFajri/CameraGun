<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg_dark"
    android:keepScreenOn="true">

    <!-- ================================================================= -->
    <!-- MODE 1: CAMERA REFLEX LIGHTGUN (LANDSCAPE)                        -->
    <!-- ================================================================= -->

    <!-- Layer 0: Camera Preview (Full screen) -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Layer 1: Corner Detection & Reticle HUD -->
    <com.cameragun.lightgun.CornerOverlayView
        android:id="@+id/cornerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Layer 2: Camera Mode Top Bar (Ultra-slim, semi-transparent, no shadow bug) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="#660A0E1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <!-- BT Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/dotBt"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_indicator" />
            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/bt_disconnected"
                android:textColor="@color/cyber_orange"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- Tracking Status -->
        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tracking_lost"
            android:textColor="@color/cyber_orange"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- Coordinates -->
        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="X: 0.000 | Y: 0.000"
            android:textColor="@color/cyber_text_primary"
            android:textSize="9sp" />

        <View android:layout_width="1dp" android:layout_height="12dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- FPS Counter -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0 FPS"
            android:textColor="@color/cyber_green"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Player Role (1P / 2P) -->
        <Button
            android:id="@+id/btnPlayerRole"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🎯 1P"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Recenter Button -->
        <Button
            android:id="@+id/btnRecenter"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="8dp"
            android:text="🎯 RECENTER"
            android:textColor="@color/cyber_green"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Wi-Fi Connect Button -->
        <Button
            android:id="@+id/btnWifi"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="📶 WI-FI"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Switch to Pure Gyro Mode Button -->
        <Button
            android:id="@+id/btnToggleOrientation"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="8dp"
            android:text="🎮 GYRO MODE"
            android:textColor="@color/cyber_orange"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Border Color Quick Toggle -->
        <Button
            android:id="@+id/btnBorderColor"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🎨 CYAN"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Help Button -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_menu"
            android:text="?"
            android:textColor="@color/cyber_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Layer 3: Landscape Camera Controls -->
    <FrameLayout
        android:id="@+id/landscapeControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Left Controls: L2 Trigger, Share, D-Pad -->
        <RelativeLayout
            android:id="@+id/leftControls"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTriggerL2"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_cyber_trigger"
                android:text="TRIGGER\nL2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="55dp"
                android:layout_height="34dp"
                android:layout_toEndOf="@id/btnTriggerL2"
                android:layout_alignParentTop="true"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="SHARE"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />

            <RelativeLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">

                <Button
                    android:id="@+id/btnDpadUp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▲"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnDpadLeft"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="◀"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnDpadRight"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▶"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnDpadDown"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_dpad"
                    android:text="▼"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="16sp" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Right Controls: R2 Trigger, Options, Action Buttons (△, □, ○, ✖) -->
        <RelativeLayout
            android:id="@+id/rightControls"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTriggerR2"
                android:layout_width="85dp"
                android:layout_height="70dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/btn_cyber_trigger"
                android:text="ALT FIRE\nR2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <Button
                android:id="@+id/btnOptions"
                android:layout_width="55dp"
                android:layout_height="34dp"
                android:layout_toStartOf="@id/btnTriggerR2"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="OPTION"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />

            <RelativeLayout
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true">

                <Button
                    android:id="@+id/btnTriangle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="△"
                    android:textColor="@color/ps_triangle"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnSquare"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="□"
                    android:textColor="@color/ps_square"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnCircle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="○"
                    android:textColor="@color/ps_circle"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnCross"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/btn_cyber_action"
                    android:text="✖"
                    android:textColor="@color/ps_cross"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Center Bottom Reload Button for Landscape -->
        <Button
            android:id="@+id/btnReload"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_cyber_reload"
            android:text="⟳  RELOAD"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:hapticFeedbackEnabled="true" />
    </FrameLayout>

    <!-- ================================================================= -->
    <!-- MODE 2: PURE GYRO REMOTE GAMEPAD (PORTRAIT / SCROLLABLE)          -->
    <!-- ================================================================= -->
    <ScrollView
        android:id="@+id/portraitControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/cyber_bg_dark"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- Mode Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ GYRO CONTROLLER"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Switch back to Camera Mode -->
                <Button
                    android:id="@+id/port_btnSwitchToCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_cyber_menu"
                    android:paddingHorizontal="10dp"
                    android:text="📷 MODE KAMERA"
                    android:textColor="@color/cyber_green"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cyber_panel"
                android:padding="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- BT Status -->
                    <View
                        android:id="@+id/port_dotBt"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_indicator" />
                    <TextView
                        android:id="@+id/port_tvBtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="BT: OFF"
                        android:textColor="@color/cyber_orange"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View android:layout_width="1dp" android:layout_height="12dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/cyber_border" />

                    <!-- Tracking Status -->
                    <TextView
                        android:id="@+id/port_tvTrackingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIM &amp; RECENTER"
                        android:textColor="@color/cyber_orange"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View android:layout_width="1dp" android:layout_height="12dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/cyber_border" />

                    <!-- Live Coords -->
                    <TextView
                        android:id="@+id/port_tvCoords"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="X: 0.500 | Y: 0.500"
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="9sp" />

                    <!-- Role Switch Button -->
                    <Button
                        android:id="@+id/port_btnPlayerRole"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/btn_cyber_menu"
                        android:paddingHorizontal="8dp"
                        android:text="🎯 1P"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Aim Mode & Quick Connect Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Aim Orientation Toggle -->
                    <Button
                        android:id="@+id/port_btnAimOrientation"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_cyber_menu"
                        android:paddingHorizontal="6dp"
                        android:text="🚀 REMOTE (UJUNG ATAS HP)"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/port_btnWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_cyber_menu"
                        android:paddingHorizontal="10dp"
                        android:text="📶 WI-FI QR"
                        android:textColor="@color/cyber_green"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Big Recenter Pad (Center Interactive Touch Target) -->
            <Button
                android:id="@+id/port_btnRecenter"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_cyber_reload"
                android:text="🎯 TEKAN UNTUK RECENTER\n(Arahkan Moncong HP ke Tengah Monitor Laptop)"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <!-- Primary Triggers Row: TRIGGER L2 & ALT FIRE R2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/port_btnTriggerL2"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_cyber_trigger"
                    android:text="TRIGGER\nL2"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:hapticFeedbackEnabled="true" />

                <Button
                    android:id="@+id/port_btnTriggerR2"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_cyber_trigger"
                    android:text="ALT FIRE\nR2"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:hapticFeedbackEnabled="true" />
            </LinearLayout>

            <!-- Arcade Controls: D-Pad & Action Buttons Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- D-Pad (Left) -->
                <RelativeLayout
                    android:id="@+id/port_dpadArea"
                    android:layout_width="140dp"
                    android:layout_height="140dp">

                    <Button
                        android:id="@+id/port_btnDpadUp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_cyber_dpad"
                        android:text="▲"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="18sp" />
                    <Button
                        android:id="@+id/port_btnDpadLeft"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_cyber_dpad"
                        android:text="◀"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="18sp" />
                    <Button
                        android:id="@+id/port_btnDpadRight"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_cyber_dpad"
                        android:text="▶"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="18sp" />
                    <Button
                        android:id="@+id/port_btnDpadDown"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_cyber_dpad"
                        android:text="▼"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="18sp" />
                </RelativeLayout>

                <!-- Middle Menu Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/port_btnShare"
                        android:layout_width="54dp"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_cyber_menu"
                        android:text="SHARE"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/port_btnOptions"
                        android:layout_width="54dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_cyber_menu"
                        android:text="OPTION"
                        android:textColor="@color/cyber_text_secondary"
                        android:textSize="8sp" />
                </LinearLayout>

                <!-- PlayStation Action Buttons (Right) -->
                <RelativeLayout
                    android:id="@+id/port_actionArea"
                    android:layout_width="140dp"
                    android:layout_height="140dp">

                    <Button
                        android:id="@+id/port_btnTriangle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_cyber_action"
                        android:text="△"
                        android:textColor="@color/ps_triangle"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/port_btnSquare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_cyber_action"
                        android:text="□"
                        android:textColor="@color/ps_square"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/port_btnCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_cyber_action"
                        android:text="○"
                        android:textColor="@color/ps_circle"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/port_btnCross"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_cyber_action"
                        android:text="✖"
                        android:textColor="@color/ps_cross"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Wide Reload Bar at the bottom -->
            <Button
                android:id="@+id/port_btnReload"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_cyber_reload"
                android:text="⟳  RELOAD"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />
        </LinearLayout>
    </ScrollView>

    <!-- ================================================================= -->
    <!-- Layer 5: Tutorial & Setup Guide Modal Overlay                     -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/layoutTutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"
            android:background="@drawable/bg_cyber_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="📖 PANDUAN PENGGUNAAN"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseTutorial"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_menu"
                    android:text="✕"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="14sp" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cyber_border"
                android:layout_marginBottom="8dp" />

            <!-- Scrollable Guide Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 MODE PENGGUNAAN"
                        android:textColor="@color/cyber_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1. Mode Kamera (Landscape):\nMembidik langsung ke layar laptop menggunakan kamera reflex HP.\n\n2. Mode Gyro Remote (Portrait / Posisi Tidur):\nKamera HP mati total (hemat baterai & enteng). HP dipegang secara portrait / posisi tidur mengarah ke laptop dengan refresh rate 100Hz murni dari sensor gyro!"
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cyber_border"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 CARA KALIBRASI RECENTER"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Arahkan moncong HP ke bagian tengah layar laptop Anda, lalu tekan tombol '🎯 RECENTER'. Posisi tengah langsung terkunci!"
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnGotIt"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_cyber_reload"
                        android:text="SIAP MAIN! 🚀"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
