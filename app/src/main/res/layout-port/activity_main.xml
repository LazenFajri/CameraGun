<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg_dark"
    android:keepScreenOn="true">

    <!-- Layer 0: Camera Preview (Full screen) -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Corner Detection & Reticle HUD -->
    <com.cameragun.lightgun.CornerOverlayView
        android:id="@+id/cornerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: Top HUD Status Bar (Portrait adapted) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_cyber_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <!-- BT Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/dotBt"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_indicator" />
            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/bt_disconnected"
                android:textColor="@color/cyber_orange"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- Tracking Status -->
        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tracking_lost"
            android:textColor="@color/cyber_orange"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- FPS Counter -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="0 FPS"
            android:textColor="@color/cyber_green"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/cyber_border" />

        <!-- Orientation Switcher Button -->
        <Button
            android:id="@+id/btnToggleOrientation"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🖥️ LAND"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />

        <View android:layout_width="1dp" android:layout_height="14dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/cyber_border" />

        <!-- Border Color Quick Toggle -->
        <Button
            android:id="@+id/btnBorderColor"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/btn_cyber_menu"
            android:paddingHorizontal="6dp"
            android:text="🎨 CYAN"
            android:textColor="@color/cyber_cyan"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Coordinates Sub-Bar -->
    <TextView
        android:id="@+id/tvCoords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="78dp"
        android:background="@drawable/bg_cyber_panel"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:fontFamily="monospace"
        android:text="X: 0.000 | Y: 0.000"
        android:textColor="@color/cyber_text_primary"
        android:textSize="9sp" />

    <!-- Side Button: Help / Tutorial -->
    <Button
        android:id="@+id/btnHelp"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="110dp"
        android:background="@drawable/btn_cyber_menu"
        android:text="?"
        android:textColor="@color/cyber_cyan"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Layer 3: PORTRAIT CONTROLS (Pistol Grip Layout) -->
    <RelativeLayout
        android:id="@+id/portraitControls"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp">

        <!-- D-Pad (Left side) -->
        <RelativeLayout
            android:id="@+id/dpadArea"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignParentStart="true"
            android:layout_above="@id/btnReload"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnDpadUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▲"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnDpadLeft"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="◀"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnDpadRight"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▶"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnDpadDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_dpad"
                android:text="▼"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Triggers Area (Center / Right) -->
        <LinearLayout
            android:id="@+id/triggerArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/dpadArea"
            android:layout_toStartOf="@id/actionArea"
            android:layout_above="@id/btnReload"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- L2 Primary Trigger (Big ergonomic pistol trigger) -->
            <Button
                android:id="@+id/btnTriggerL2"
                android:layout_width="100dp"
                android:layout_height="65dp"
                android:background="@drawable/btn_cyber_trigger"
                android:text="TRIGGER\nL2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />

            <!-- R2 Secondary Fire -->
            <Button
                android:id="@+id/btnTriggerR2"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_cyber_trigger"
                android:text="ALT R2"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:hapticFeedbackEnabled="true" />
        </LinearLayout>

        <!-- PlayStation Action Buttons (Right side) -->
        <RelativeLayout
            android:id="@+id/actionArea"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/btnReload"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTriangle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_action"
                android:text="△"
                android:textColor="@color/ps_triangle"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnSquare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_action"
                android:text="□"
                android:textColor="@color/ps_square"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnCircle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_action"
                android:text="○"
                android:textColor="@color/ps_circle"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnCross"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_cyber_action"
                android:text="✖"
                android:textColor="@color/ps_cross"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Option & Share Buttons (Small) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/triggerArea"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShare"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="SHARE"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btnOptions"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:background="@drawable/btn_cyber_menu"
                android:text="OPTION"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Wide Reload Bar at the very bottom -->
        <Button
            android:id="@+id/btnReload"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/btn_cyber_reload"
            android:text="⟳  RELOAD"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:hapticFeedbackEnabled="true" />
    </RelativeLayout>

    <!-- Layer 4: Tutorial & Setup Guide Modal Overlay -->
    <FrameLayout
        android:id="@+id/layoutTutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60A0E1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="30dp"
            android:background="@drawable/bg_cyber_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="📖 PANDUAN PENGGUNAAN"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseTutorial"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_cyber_menu"
                    android:text="✕"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="13sp" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cyber_border"
                android:layout_marginBottom="8dp" />

            <!-- Scrollable Guide Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section: Apakah Wajib ViGEmBus? -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❓ APAKAH HARUS PAKAI VIGEMBUS?"
                        android:textColor="@color/cyber_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TIDAK WAJIB! PC Server otomatis menggunakan Absolute Mouse Pointer yang langsung kompatibel dengan Teknoparrot, Dolphin Wii, MAME, dan game PC tanpa driver apapun."
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="10sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Section: Cara Membidik -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 1. CARA MEMBIDIK (PORTRAIT / LANDSCAPE)"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Anda bisa bermain dalam posisi TEGAK (Portrait) seperti pistol sungguhan, atau MENDATAR (Landscape).\n• Tekan tombol '🔄 ROTATE' di bar atas untuk mengganti orientasi.\n• Arahkan kamera HP ke monitor sampai kotak hijau 'TARGET: LOCKED' aktif."
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="10sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Section: Tombol Kontrol -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 2. FUNGSI TOMBOL"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• L2 (TRIGGER): Tembakan utama (Left Click).\n• R2: Tembakan sekunder / granat (Right Click).\n• RELOAD: Tombol bawah atau arahkan laras ke bawah / luar layar untuk reload otomatis."
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="10sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </ScrollView>

            <Button
                android:id="@+id/btnGotIt"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:background="@drawable/btn_cyber_menu"
                android:text="✓ SAYA MENGERTI"
                android:textColor="@color/cyber_green"
                android:textSize="10sp"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
